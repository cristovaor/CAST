# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=cast_user
POSTGRES_PASSWORD=cast_password
POSTGRES_DB=cast_db

# Configurações do MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Segurança / JWT Backend
SECRET_KEY=sua_chave_secreta_super_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Login com Google (opcional em desenvolvimento).
# Deixar FIREBASE_PROJECT_ID vazio desativa o login com Google; o login por
# e-mail/password continua a funcionar. Para o deploy na VPS use antes o
# .env.easypanel.example (ver docs/deployment/DEPLOY_EASYPANEL.md).
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Convites. O registo é apenas por convite: crie o primeiro admin com
#   python -m app.scripts.bootstrap_admin --email voce@exemplo.com --name "Nome"
INVITATION_ACCEPT_URL=http://localhost:5173/accept-invite
INVITATION_EXPIRE_HOURS=168

# Envio de convites por e-mail. Com SMTP_HOST vazio o convite é criado na mesma
# e o link é devolvido ao admin para partilha manual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CAST Platform <no-reply@localhost>

# Origens autorizadas a chamar a API. Vazio mantém o default permissivo do
# desenvolvimento local; em produção tem de listar a origem real do frontend.
CORS_ORIGINS=
# Feature flags. Em Docker, passe cada flag ao backend e ao worker responsável;
# este arquivo é lido diretamente pela API apenas fora do Compose padrão.
EEG_ANALYSIS_V2_ENABLED=false
LIVE_CAPTURE_ENABLED=false
LSL_ACQUISITION_ENABLED=false
FACE_LANDMARKER_V2_ENABLED=false
EXPERIMENTAL_CONTEXT_ENABLED=false
MULTIMODAL_EXPLORER_ENABLED=false
GAZE_EXPERIMENT_ENABLED=false
PUPIL_EXPERIMENT_ENABLED=false

# Limites de upload do bundle EEG.
EEG_UPLOAD_MAX_FILES=256
EEG_UPLOAD_MAX_TOTAL_BYTES=53687091200
