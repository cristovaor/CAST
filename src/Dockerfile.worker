FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including OpenCV/MediaPipe requirements
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install ALL dependencies including ML
RUN pip install --no-cache-dir -r requirements.txt

# Worker/test-only columnar runtime. Kept out of Dockerfile.api so the
# production API image does not carry MediaPipe/Parquet dependencies.
RUN pip install --no-cache-dir "pyarrow>=16.0.0" "bcrypt==4.0.1"

# Audio synchronization runtime. Kept after the large ML layer so adding or
# updating FFmpeg does not invalidate the multi-gigabyte Python dependency cache.
RUN apt-get update && apt-get install -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# MediaPipe Legacy Solutions needs protobuf/numpy versions that conflict with
# the current TensorFlow inference runtime. Keep extraction isolated so both
# jobs can coexist in the same worker image without dependency corruption.
RUN python -m venv /opt/mediapipe-legacy \
    && /opt/mediapipe-legacy/bin/pip install --no-cache-dir \
        "numpy==1.26.4" \
        "protobuf==4.25.9" \
        "opencv-contrib-python==4.11.0.86" \
        "pandas>=2.1,<3" \
        "absl-py" \
        "attrs" \
        "flatbuffers" \
        "matplotlib" \
        "sounddevice" \
        "sentencepiece" \
    && /opt/mediapipe-legacy/bin/pip install --no-cache-dir --no-deps \
        "mediapipe==0.10.21"

# Scientific inference runtime is layered separately so updates do not
# invalidate the much larger ML dependency layers above.
COPY requirements-scientific.txt .
RUN pip install --no-cache-dir -r requirements-scientific.txt

# Copy the rest of the application
COPY . .

# Command to run the Celery worker
CMD ["celery", "-A", "app.workers.celery_app", "worker", "-l", "info", "-Q", "celery"]
