FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including OpenCV/MediaPipe requirements
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Multi-GB downloads over slow links: wait longer per read and retry instead of
# failing the whole build on one stalled connection.
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

COPY requirements.txt .

# CPU-only PyTorch first, from PyTorch's CPU index. Resolved from PyPI,
# `torch>=2.1.0` pulls the CUDA build plus several GB of nvidia-* wheels that a
# host without a GPU never uses. Once this is installed, requirements.txt
# treats torch as already satisfied.
#
# The BuildKit cache mount keeps downloaded wheels between builds, so a build
# interrupted by a network timeout resumes instead of starting over; nothing
# from the cache ends up in the image.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch==2.7.1+cpu --index-url https://download.pytorch.org/whl/cpu

# Install ALL dependencies including ML
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Worker/test-only columnar runtime. Kept out of Dockerfile.api so the
# production API image does not carry MediaPipe/Parquet dependencies.
RUN pip install --no-cache-dir "pyarrow>=16.0.0" "bcrypt==4.0.1"

# Audio synchronization and MediaPipe Tasks GLES/EGL runtime. Kept after the
# large ML layer to preserve the multi-gigabyte Python dependency cache.
RUN apt-get update && apt-get install -y ffmpeg libgles2 libegl1 \
    && rm -rf /var/lib/apt/lists/*

# MediaPipe Legacy Solutions needs protobuf/numpy versions that conflict with
# the current TensorFlow inference runtime. Keep extraction isolated so both
# jobs can coexist in the same worker image without dependency corruption.
RUN python -m venv /opt/mediapipe-legacy \
    && /opt/mediapipe-legacy/bin/pip install --no-cache-dir \
        "numpy==1.26.4" \
        "protobuf==4.25.9" \
        "opencv-contrib-python==4.11.0.86" \
        "pandas>=2.1,<3" \
        "absl-py" \
        "attrs" \
        "flatbuffers" \
        "matplotlib" \
        "sounddevice" \
        "sentencepiece" \
    && /opt/mediapipe-legacy/bin/pip install --no-cache-dir --no-deps \
        "mediapipe==0.10.21"

# Tasks must also run without TensorFlow: its optional docgen import can cause
# a native allocator crash when both runtimes share a process.
COPY requirements-mediapipe-tasks.txt .
RUN python -m venv /opt/mediapipe-tasks \
    && /opt/mediapipe-tasks/bin/pip install --no-cache-dir -r requirements-mediapipe-tasks.txt

# Scientific inference runtime is layered separately so updates do not
# invalidate the much larger ML dependency layers above.
COPY requirements-scientific.txt .
RUN pip install --no-cache-dir -r requirements-scientific.txt

# Copy the rest of the application
COPY . .

# Command to run the Celery worker
CMD ["celery", "-A", "app.workers.celery_app", "worker", "-l", "info", "-Q", "celery"]
