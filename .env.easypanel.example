# CAST — EasyPanel/VPS deployment variables.
#
# Copy to `.env` NEXT TO docker-compose.easypanel.build.yml on the VPS and fill
# in every value. Compose reads `.env` automatically:
#
#   cp .env.easypanel.example .env && nano .env
#   docker compose -f docker-compose.easypanel.build.yml up -d --build
#
# Never commit the filled-in file: `.env` is gitignored for exactly this reason.

# ── Public URLs ────────────────────────────────────────────────────────────
# Where the SPA is served from, and where the browser reaches the API. Both are
# baked into the frontend bundle at BUILD time, so changing them requires
# rebuilding the frontend image (`up -d --build`), not just restarting it.
VITE_API_URL=https://api.cast.crlabs.com.br/api/v1
# MinIO must sit at the ROOT of its own domain: presigned URLs are signed
# against this exact origin, and a stripped path prefix breaks every signature.
MINIO_PUBLIC_URL=https://storage.cast.crlabs.com.br
VITE_ENV=production

# Browser origins allowed to call the API — the frontend's origin, comma
# separated for more than one. Required: leaving it unset falls back to "*",
# which lets any website call the API with a logged-in user's token.
CORS_ORIGINS=https://cast.crlabs.com.br

# ── Shared EasyPanel Postgres ──────────────────────────────────────────────
# Hostname of the shared Postgres service on the easypanel-doutorado overlay
# network (NOT localhost). Create the database and role before first deploy.
POSTGRES_SERVER=doutorado_postgres-shared
POSTGRES_USER=cast_user
POSTGRES_PASSWORD=
POSTGRES_DB=cast_db

# ── Shared EasyPanel Redis ─────────────────────────────────────────────────
# Use a dedicated Redis DB index so CAST's Celery queues never collide with
# another project's (CSH-MARL uses /0). The shared Redis requires auth: user
# "default" plus the password shown in EasyPanel → redis-shared → Credentials.
REDIS_URL=redis://default:REDIS_PASSWORD@doutorado_redis-shared:6379/3

# ── Application secrets ────────────────────────────────────────────────────
# Signs CAST session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this value invalidates every active session.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Object storage credentials (MinIO runs inside this stack).
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Invite-only Google login ───────────────────────────────────────────────
# Server-side: the Firebase project ID, which is also the expected audience of
# every ID token. A token minted for any other project is rejected. Leave
# empty to disable Google login entirely (password login still works).
FIREBASE_PROJECT_ID=

# Client-side Firebase web config (Firebase console → Project settings → Your
# apps → Web app → SDK setup and configuration). These are public values: they
# identify the project and authorize nothing on their own. VITE_FIREBASE_PROJECT_ID
# must match FIREBASE_PROJECT_ID above, or every sign-in fails audience checks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Where invitation links point. Must be the frontend origin + /accept-invite.
INVITATION_ACCEPT_URL=https://cast.crlabs.com.br/accept-invite
INVITATION_EXPIRE_HOURS=168

# ── Invitation e-mail (optional) ───────────────────────────────────────────
# Leave SMTP_HOST empty to skip sending: invitations are still created and the
# admin UI returns the link to share by hand. Nothing fails silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CAST Platform <no-reply@crlabs.com.br>
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Sizing ─────────────────────────────────────────────────────────────────
API_WORKERS=2
# Video/ML jobs run on CPU here (there is no GPU and no Triton in this stack),
# so keep concurrency low: each worker slot can hold a whole video in memory.
WORKER_CONCURRENCY=2

# ── Feature flags ──────────────────────────────────────────────────────────
# Passed to the API and both workers. Enable one only after its Alembic
# migrations have run (the backend applies them on startup).
EEG_ANALYSIS_V2_ENABLED=false
LSL_ACQUISITION_ENABLED=false
LIVE_CAPTURE_ENABLED=false
FACE_LANDMARKER_V2_ENABLED=false
EXPERIMENTAL_CONTEXT_ENABLED=false
MULTIMODAL_EXPLORER_ENABLED=false
GAZE_EXPERIMENT_ENABLED=false
PUPIL_EXPERIMENT_ENABLED=false

# EEG bundle upload limits (defaults: 256 files, 50 GiB).
EEG_UPLOAD_MAX_FILES=256
EEG_UPLOAD_MAX_TOTAL_BYTES=53687091200
